generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
  CUSTOMER
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  SIMULATED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  email         String               @unique @db.VarChar(254)
  name          String               @db.VarChar(120)
  passwordHash  String               @db.VarChar(255)
  role          Role                 @default(CUSTOMER)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  business      Business?
  cart          Cart?
  addresses     Address[]
  orders        Order[]
  refreshTokens RefreshToken[]
  statusChanges OrderStatusHistory[]

  @@index([role, isActive])
}

model Business {
  id           String         @id @default(uuid()) @db.Uuid
  ownerId      String         @unique @db.Uuid
  name         String         @db.VarChar(120)
  slug         String         @unique @db.VarChar(160)
  description  String         @default("")
  logo         String?
  banner       String?
  email        String         @db.VarChar(254)
  phone        String         @db.VarChar(30)
  address      String
  status       BusinessStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products     Product[]
  sellerOrders SellerOrder[]

  @@index([status, createdAt])
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(80)
  slug        String     @unique @db.VarChar(100)
  description String     @default("")
  isActive    Boolean    @default(true)
  parentId    String?    @db.Uuid
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@index([isActive])
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  categoryId         String              @db.Uuid
  name               String              @db.VarChar(180)
  slug               String              @unique @db.VarChar(220)
  description        String
  price              Decimal             @db.Decimal(12, 2)
  stock              Int                 @default(0)
  sku                String              @db.VarChar(80)
  status             ProductStatus       @default(INACTIVE)
  mainImage          String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([id, businessId])
  @@unique([businessId, sku])
  @@index([businessId, status, createdAt])
  @@index([categoryId, status, price])
  @@index([status, createdAt])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@unique([productId, url])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model Address {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  label                String   @db.VarChar(80)
  recipientName        String   @db.VarChar(120)
  phone                String   @db.VarChar(30)
  addressLine          String
  city                 String   @db.VarChar(100)
  region               String   @db.VarChar(100)
  postalCode           String?  @db.VarChar(20)
  countryCode          String   @default("GT") @db.Char(2)
  deliveryInstructions String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id                   String        @id @default(uuid()) @db.Uuid
  number               Int           @unique @default(autoincrement())
  customerId           String        @db.Uuid
  total                Decimal       @db.Decimal(14, 2)
  currency             String        @default("GTQ") @db.Char(3)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(PENDING)
  recipientName        String        @db.VarChar(120)
  phone                String        @db.VarChar(30)
  addressLine          String
  city                 String        @db.VarChar(100)
  region               String        @db.VarChar(100)
  postalCode           String?       @db.VarChar(20)
  countryCode          String        @default("GT") @db.Char(2)
  deliveryInstructions String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  customer             User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerOrders         SellerOrder[]

  @@index([customerId, createdAt])
  @@index([createdAt])
}

model SellerOrder {
  id                 String               @id @default(uuid()) @db.Uuid
  orderId            String               @db.Uuid
  businessId         String               @db.Uuid
  subtotal           Decimal              @db.Decimal(14, 2)
  status             OrderStatus          @default(PENDING)
  stockDeductedAt    DateTime?            @db.Timestamptz(3)
  stockRestoredAt    DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  inventoryMovements InventoryMovement[]

  @@unique([id, businessId])
  @@unique([orderId, businessId])
  @@index([businessId, status, createdAt])
}

model OrderItem {
  id            String      @id @default(uuid()) @db.Uuid
  sellerOrderId String      @db.Uuid
  productId     String      @db.Uuid
  businessId    String      @db.Uuid
  productName   String      @db.VarChar(180)
  sku           String      @db.VarChar(80)
  unitPrice     Decimal     @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  product       Product     @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sellerOrderId, productId])
  @@index([sellerOrderId, businessId])
  @@index([productId, businessId])
}

model OrderStatusHistory {
  id            String       @id @default(uuid()) @db.Uuid
  sellerOrderId String       @db.Uuid
  actorId       String       @db.Uuid
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  note          String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  sellerOrder   SellerOrder  @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  actor         User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId, createdAt])
  @@index([actorId])
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  productId     String                @db.Uuid
  businessId    String                @db.Uuid
  sellerOrderId String?               @db.Uuid
  type          InventoryMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  product       Product               @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)
  sellerOrder   SellerOrder?          @relation(fields: [sellerOrderId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: Restrict)

  @@index([productId, businessId, createdAt])
  @@index([sellerOrderId, businessId])
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  tokenHash    String        @unique @db.Char(64)
  familyId     String        @db.Uuid
  expiresAt    DateTime      @db.Timestamptz(3)
  revokedAt    DateTime?     @db.Timestamptz(3)
  replacedById String?       @unique @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}
