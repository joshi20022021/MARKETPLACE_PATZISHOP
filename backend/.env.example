# Prisma consume DATABASE_URL desde la fase 3; el resto se usa en etapas posteriores.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# npm run db:backend-env prepara la conexión local sin sobrescribir backend/.env.
DATABASE_URL=
# Generar secretos diferentes localmente durante la fase 5.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
