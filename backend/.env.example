# Prisma y NestJS consumen este entorno desde la raíz del workspace backend.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# Opcional: true/false. Si no se define, Swagger se desactiva en production.
# SWAGGER_ENABLED=true
# npm run db:backend-env prepara la conexión local sin sobrescribir backend/.env.
DATABASE_URL=
# Generar secretos diferentes localmente durante la fase 5.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
