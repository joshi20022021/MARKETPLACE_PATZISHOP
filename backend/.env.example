# Prisma y NestJS consumen este entorno desde la raíz del workspace backend.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# Opcional: true/false. Si no se define, Swagger se desactiva en production.
# SWAGGER_ENABLED=true
# npm run db:backend-env prepara la conexión local sin sobrescribir backend/.env.
DATABASE_URL=
# npm run auth:env genera 32 bytes aleatorios en hexadecimal sin imprimirlos.
# Obligatorio: 64 a 512 caracteres sin espacios. Usar un secreto propio por entorno.
JWT_ACCESS_SECRET=
# Unidades s/m/h; duración positiva de hasta una hora.
JWT_ACCESS_TTL=15m
# Entero de 1 a 30; vigencia absoluta, no se extiende al rotar.
REFRESH_TOKEN_TTL_DAYS=7
