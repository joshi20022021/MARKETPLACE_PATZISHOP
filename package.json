{
  "name": "mercado-multivendedor",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace multi-vendedor desarrollado por etapas",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "verify:setup": "node scripts/verify-setup.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run verify:setup && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  }
}
