{
  "name": "mercado-multivendedor",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace multi-vendedor desarrollado por etapas",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "test:products": "npm run test:products --workspace backend",
    "test:categories": "npm run test:categories --workspace backend",
    "test:businesses": "npm run test:businesses --workspace backend",
    "build:backend": "npm run build --workspace backend",
    "start:backend": "npm run start --workspace backend",
    "dev:backend": "npm run start:dev --workspace backend",
    "test:api": "npm run test:api --workspace backend",
    "db:env": "node scripts/init-db-env.mjs",
    "db:up": "docker compose up -d --wait --wait-timeout 120 postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --tail 100 postgres",
    "db:check": "node scripts/verify-db.mjs",
    "db:backend-env": "node scripts/init-backend-env.mjs",
    "prisma:validate": "npm run prisma:validate --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend --",
    "prisma:deploy": "npm run prisma:deploy --workspace backend",
    "prisma:status": "npm run prisma:status --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "test:database": "npm run test:database --workspace backend",
    "typecheck": "npm run typecheck --workspace backend",
    "verify:setup": "node scripts/verify-setup.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run verify:setup && npm run lint && npm run format:check",
    "auth:env": "node scripts/init-auth-env.mjs",
    "test:auth": "npm run test:auth --workspace backend",
    "test:security": "npm run test:security --workspace backend"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  }
}
